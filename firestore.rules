rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function allowedEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'rupesh.mudlar@cognizantchemical.com',
          'indra@cognizantchemical.com',
          'production@cognizantchemical.com',
          'qa@cognizantchemical.com',
          'anzarsayyed02@gmail.com'
        ];
    }
    function activeUser() {
      return allowedEmail() && exists(/databases/$(database)/documents/companies/ccpl/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/ccpl/users/$(request.auth.uid)).data.active == true;
    }
    function admin() { return activeUser() && request.auth.token.email == 'rupesh.mudlar@cognizantchemical.com'; }

    match /companies/ccpl/users/{uid} {
      allow read: if allowedEmail() && (uid == request.auth.uid || admin());
      allow create: if allowedEmail() && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.role == (request.auth.token.email == 'rupesh.mudlar@cognizantchemical.com' ? 'admin' : 'staff');
      allow update, delete: if admin();
    }

    // Masters — any approved user can add / edit; only admin deletes
    match /companies/ccpl/suppliers/{id}     { allow read, create, update: if activeUser(); allow delete: if admin(); }
    match /companies/ccpl/products/{id}      { allow read, create, update: if activeUser(); allow delete: if admin(); }
    match /companies/ccpl/packMaterials/{id} { allow read, create, update: if activeUser(); allow delete: if admin(); }

    // Operations — same flow as CCPL Inventory V5
    match /companies/ccpl/inwards/{id}      { allow read, create, update: if activeUser(); allow delete: if admin(); }
    match /companies/ccpl/readyBatches/{id} { allow read, create, update: if activeUser(); allow delete: if admin(); }
    match /companies/ccpl/packTxns/{id}     { allow read, create: if activeUser(); allow update, delete: if admin(); }
    match /companies/ccpl/stock/{id}        { allow read, create, update: if activeUser(); allow delete: if admin(); }
    match /companies/ccpl/counters/{id}     { allow read, create, update: if activeUser(); allow delete: if admin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
